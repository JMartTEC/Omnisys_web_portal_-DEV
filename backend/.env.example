ENV_NAME=local
# JWT_SECRET: en local puede ir vacío (se genera uno temporal). En Azure viene de Key Vault.
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
COOKIE_SEGURA=false

# Usuarios: archivo (solo en tu compu) o cosmos (Azure). Alta: python -m tools.provision_usuarios
AUTH_BACKEND=archivo
# AUTH_BACKEND=cosmos
# COSMOS_ENDPOINT=https://<cuenta>.documents.azure.com:443/
# COSMOS_KEY=            # vacío = identidad administrada (recomendado)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080

# RAG - por defecto sin servicios externos
EMBEDDINGS_PROVIDER=hashing
VECTOR_STORE=memory
LLM_PROVIDER=extractive

# Para activar un LLM compatible con OpenAI (OpenAI, Azure OpenAI, vLLM):
# LLM_PROVIDER=openai
# EMBEDDINGS_PROVIDER=openai
# EMBEDDINGS_DIM=1536
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Para persistencia (Render PostgreSQL + pgvector):
# VECTOR_STORE=pgvector
# DATABASE_URL=postgresql://...
